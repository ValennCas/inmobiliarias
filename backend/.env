# Plantilla de configuracion. Se sube al repositorio sin valores

# Casilla desde la que se envian los correos, en formato DSN:  smtps://USUARIO:CLAVE@SERVIDOR:PUERTO
MAIL_DSN=

# Opcional. Vacio = el remitente es el usuario del DSN
MAIL_REMITENTE=

# Nombre que ve quien recibe el correo
MAIL_NOMBRE=

# Zona horaria
APP_TIMEZONE=

# Base de datos MySQL. Vacio = valores de XAMPP (localhost, puerto 3306, base inmobiliaria, usuario root, sin clave).
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=

DB_SSL=

